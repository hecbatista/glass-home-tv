<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:id="@+id/columnsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/columnsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/rowsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <TextView
            android:id="@+id/dockLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dock_opacity_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/dockRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <!-- Glass Home: the background colour. Light turns the text dark; any other colour comes from a theme's
             background_color. -->
        <TextView
            android:id="@+id/backgroundLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/background_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/backgroundRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/bgLight" style="@style/SettingsColumnChoice" android:text="@string/background_light" />
            <TextView android:id="@+id/bgGrey" style="@style/SettingsColumnChoice" android:text="@string/background_grey" />
            <TextView android:id="@+id/bgDark" style="@style/SettingsColumnChoice" android:text="@string/background_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backgroundRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/bgNavy" style="@style/SettingsColumnChoice" android:text="@string/background_navy" />
            <TextView android:id="@+id/bgPlum" style="@style/SettingsColumnChoice" android:text="@string/background_plum" />
            <TextView android:id="@+id/bgPine" style="@style/SettingsColumnChoice" android:text="@string/background_pine" />
        </LinearLayout>

        <!-- Glass Home: how long Home keeps the screen on (home_awake_minutes). -->
        <TextView
            android:id="@+id/awakeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/home_awake_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/awakeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/awakeTv" style="@style/SettingsColumnChoice" android:text="@string/home_awake_tv" />
            <TextView android:id="@+id/awake30" style="@style/SettingsColumnChoice" android:text="@string/home_awake_30" />
            <TextView android:id="@+id/awake60" style="@style/SettingsColumnChoice" android:text="@string/home_awake_60" />
            <TextView android:id="@+id/awake120" style="@style/SettingsColumnChoice" android:text="@string/home_awake_120" />
            <TextView android:id="@+id/awakeAlways" style="@style/SettingsColumnChoice" android:text="@string/home_awake_always" />
        </LinearLayout>

        <TextView
            android:id="@+id/awakeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_awake_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/advancedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:id="@+id/followHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:id="@+id/homeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
