<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: values-vi points them at
     the system sans-serif (#833). Glass Home uses Inter (SIL OFL, launcher/FONT-LICENSE-INTER.txt), cut down to Latin,
     Greek and Cyrillic; other scripts fall back to the system font. Inter Display, its cut for large sizes, draws the
     clock and the shelf's app name (MainActivity.setUpGlassHeader and setUpGlassShelf). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/inter_regular</string>
    <string name="font_regular" translatable="false">@font/inter_regular</string>
    <string name="font_light" translatable="false">@font/inter_regular</string>
    <string name="font_extralight" translatable="false">@font/inter_light</string>
    <string name="font_medium" translatable="false">@font/inter_medium</string>
</resources>
